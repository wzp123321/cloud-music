+
+const destroy$ = new Subject<void>();
+
+const detail = ref<UC_IUserDetail>({ profile: {} as any });
+const playlists = ref<UC_IPlaylist[]>([]);
+const level = ref<UC_IUserLevel>({ level: 0, progress: 0 });
+const subcount = ref<UC_IUserSubcount>({
